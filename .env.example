# TEST DATA ONLY. The official SLIP-39 test vector "Basic sharing 2-of-3" from
# https://github.com/trezor/python-shamir-mnemonic/blob/master/vectors.json. It belongs to no real wallet.
#
# Try it:  cp .env.example .env && uv run main.py slip39
#
# For a real wallet, do not write the mnemonic here: delete MNEMONIC and you will be prompted for it
# with hidden input. This file is plaintext on disk.

# One share per line; two of the three shares meet the threshold.
MNEMONIC="shadow pistol academic always adequate wildlife fancy gross oasis cylinder mustang wrist rescue view short owner flip making coding armed
shadow pistol academic acid actress prayer class unknown daughter sweater depict flip twice unkind craft early superior advocate guest smoking"

# Words the passphrase might be built from, concatenated in every order. The answer is TREZOR.
WORDS="ZOR wallet TRE"

# m/44'/60'/0'/0/0 of this wallet with passphrase TREZOR.
TARGET_ADDRESS="0x25b3C9CEE49c59d8864d97c4E58Db2906466c3Cf"
ACCOUNT_INDEX=0
